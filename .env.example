# Copy to .env and fill in. Never commit .env.

# --- LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: use a different (ideally stronger) model as the judge to reduce self-grading bias.
# JUDGE_MODEL=gpt-4o
# "openai" (default) or "fake" (offline deterministic test double; no key needed)
LLM_PROVIDER=openai
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=3
# Price override in USD per 1M tokens, for models not in agent/llm.py PRICES
# PRICE_INPUT_PER_1M=0.15
# PRICE_OUTPUT_PER_1M=0.60

# --- Fetching ---
FETCH_TIMEOUT_S=15
FETCH_MAX_ATTEMPTS=3
ALLOW_PRIVATE_URLS=false
CHUNK_MAX_CHARS=1500
MAX_SOURCE_CHARS=12000

# --- Quality loop ---
PASS_THRESHOLD=7
MAX_REVISIONS=2

# --- Mock scheduler ---
SCHEDULE_FILE=data/scheduled_posts.json
SCHEDULE_DELAY_MINUTES=60

# --- Web UI (CORS) ---
# Comma-separated browser origins allowed to call the API, e.g. your Vercel URL.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
